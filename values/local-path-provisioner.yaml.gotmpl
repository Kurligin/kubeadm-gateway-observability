image:
  repository: docker.io/rancher/local-path-provisioner
  # The chart has no digest field; tag@digest pins the image.
  tag: {{ printf "v%s@%s" .Values.versions.LOCAL_PATH_PROVISIONER_VERSION .Values.versions.LOCAL_PATH_PROVISIONER_DIGEST | quote }}

# Upstream default is busybox:latest; pinned for reproducibility.
helperImage:
  repository: docker.io/library/busybox
  tag: {{ printf "%s@%s" .Values.versions.BUSYBOX_IMAGE_TAG .Values.versions.BUSYBOX_DIGEST | quote }}

storageClass:
  create: true
  name: local-path
  defaultClass: true
  reclaimPolicy: Delete
  volumeBindingMode: WaitForFirstConsumer

nodePathMap:
  - node: DEFAULT_PATH_FOR_NON_LISTED_NODES
    paths:
      - /opt/local-path-provisioner

# The provisioner itself only talks to the API server (the helper pods it
# starts do the work on the node), so it runs unprivileged; the settings
# suggested by the upstream chart.
podSecurityContext:
  runAsNonRoot: true
  seccompProfile:
    type: RuntimeDefault
securityContext:
  allowPrivilegeEscalation: false
  capabilities:
    drop: ["ALL"]
  runAsUser: 65534
  runAsGroup: 65534
  readOnlyRootFilesystem: true
resources:
  requests:
    cpu: 10m
    memory: 32Mi
  limits:
    memory: 128Mi
