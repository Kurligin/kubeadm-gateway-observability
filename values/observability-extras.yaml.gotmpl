alertReceiver:
  image: {{ .Values.versions.ALERT_RECEIVER_IMAGE | quote }}

envoyGateway:
  appClusterRegex: {{ printf "httproute/%s/app/rule/[0-9]+" .Values.gateway.namespace | quote }}

gateway:
  namespace: {{ .Values.gateway.namespace | quote }}
  name: {{ .Values.gateway.name | quote }}

logging:
  namespace: {{ .Values.logging.nodeNamespace | quote }}

victoriaLogs:
  url: {{ printf "http://%s.%s.svc:%v" .Values.logging.service .Values.logging.namespace .Values.logging.port | quote }}
  job: {{ .Values.logging.service | quote }}
  namespace: {{ .Values.logging.namespace | quote }}

tracing:
  enabled: {{ .Values.tracing.enabled }}
  url: {{ printf "http://%s.%s.svc:%v/select/jaeger" .Values.tracing.service .Values.tracing.namespace .Values.tracing.port | quote }}
  job: {{ .Values.tracing.service | quote }}
  namespace: {{ .Values.tracing.namespace | quote }}
