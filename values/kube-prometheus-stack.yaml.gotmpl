# Prometheus, Alertmanager, Grafana, node-exporter and kube-state-metrics,
# sized for a single node with 4-8 GB of RAM.
#
# Images: tag and digest from versions.env (<NAME>_IMAGE = <tag>@sha256:<hex>).
# Most templates of this chart want the bare hex ("sha"), kube-state-metrics
# and node-exporter the "sha256:<hex>" form.
{{- $v := .Values.versions }}
{{- $tag := dict }}
{{- $sha := dict }}
{{- $digest := dict }}
{{- range $key := list "PROMETHEUS_OPERATOR_IMAGE" "PROMETHEUS_CONFIG_RELOADER_IMAGE" "PROMETHEUS_IMAGE" "ALERTMANAGER_IMAGE" "THANOS_IMAGE" "GRAFANA_IMAGE" "GRAFANA_SIDECAR_IMAGE" "KUBE_STATE_METRICS_IMAGE" "NODE_EXPORTER_IMAGE" }}
{{-   $parts := splitList "@" (index $v $key) }}
{{-   $_ := set $tag $key (first $parts) }}
{{-   $_ := set $digest $key (last $parts) }}
{{-   $_ := set $sha $key (last $parts | trimPrefix "sha256:") }}
{{- end }}

# The Prometheus Operator CRDs are a separate release
# (prometheus-operator-crds), installed before everything else.
crds:
  enabled: false

defaultRules:
  rules:
    # No kube-proxy (Cilium replaces it) and no Windows nodes.
    kubeProxy: false
    windows: false

# --- Prometheus Operator ---
prometheusOperator:
  image:
    tag: {{ $tag.PROMETHEUS_OPERATOR_IMAGE | quote }}
    sha: {{ $sha.PROMETHEUS_OPERATOR_IMAGE | quote }}
  # Passed to the operator as the default image of Thanos sidecars; no
  # Thanos runs here.
  thanosImage:
    tag: {{ $tag.THANOS_IMAGE | quote }}
    sha: {{ $sha.THANOS_IMAGE | quote }}
  # No validating/mutating webhooks: they need an extra certificate job on
  # every upgrade and can race with the first install. PrometheusRules are
  # checked by `promtool check rules` in `make lint` instead.
  admissionWebhooks:
    enabled: false
  # Operator's own HTTPS listener uses the webhook certificate.
  tls:
    enabled: false
  resources:
    requests:
      cpu: 20m
      memory: 48Mi
    limits:
      memory: 192Mi
  prometheusConfigReloader:
    image:
      tag: {{ $tag.PROMETHEUS_CONFIG_RELOADER_IMAGE | quote }}
      sha: {{ $sha.PROMETHEUS_CONFIG_RELOADER_IMAGE | quote }}
    resources:
      requests:
        cpu: 10m
        memory: 16Mi
      limits:
        memory: 64Mi

# --- Prometheus ---
prometheus:
  prometheusSpec:
    image:
      tag: {{ $tag.PROMETHEUS_IMAGE | quote }}
      sha: {{ $sha.PROMETHEUS_IMAGE | quote }}
    scrapeInterval: 30s
    evaluationInterval: 30s
    # Three days of metrics, capped in size so the node disk never fills up
    # (the oldest blocks are dropped first; the PVC below leaves room for the
    # write-ahead log and compaction on top of this cap).
    retention: 3d
    retentionSize: 3GB
    # UI is published through the Gateway (basic auth).
    externalUrl: {{ printf "https://prometheus.%s" .Values.domain | quote }}
    # Pick up ServiceMonitors, PodMonitors, Probes and PrometheusRules from
    # every namespace, not only those labelled for this Helm release.
    serviceMonitorSelectorNilUsesHelmValues: false
    podMonitorSelectorNilUsesHelmValues: false
    probeSelectorNilUsesHelmValues: false
    ruleSelectorNilUsesHelmValues: false
    scrapeConfigSelectorNilUsesHelmValues: false
    resources:
      requests:
        cpu: 100m
        memory: 384Mi
      limits:
        memory: 1536Mi
    storageSpec:
      volumeClaimTemplate:
        spec:
          storageClassName: local-path
          accessModes: ["ReadWriteOnce"]
          resources:
            requests:
              storage: 4Gi

# --- Alertmanager ---
# One replica. Every alert (except the technical InfoInhibitor) goes to the
# in-cluster webhook receiver of observability-extras, which writes it as a
# JSON line to its log: alerts end up in VictoriaLogs next to the logs
# (`alertname:Watchdog`), besides the Alertmanager, Prometheus and Grafana
# UIs. Watchdog (always firing) is sent every few minutes: its records in
# VictoriaLogs prove that the whole chain Prometheus -> Alertmanager ->
# receiver -> Fluentd -> VictoriaLogs works (checked by `make verify`).
# The inhibition rules stay the chart defaults.
alertmanager:
  config:
    route:
      receiver: alert-log
      routes:
        - receiver: "null"
          matchers:
            - alertname = "InfoInhibitor"
        - receiver: alert-log
          matchers:
            - alertname = "Watchdog"
          group_wait: 10s
          group_interval: 1m
          repeat_interval: 4m
    receivers:
      - name: "null"
      - name: alert-log
        webhook_configs:
          - url: {{ printf "http://alert-receiver.%s.svc:8080/alerts" .Values.monitoring.namespace | quote }}
            send_resolved: true
            # One notification stays well below the 1 MiB the receiver
            # accepts; the alerts beyond 200 of a group are left out of it.
            max_alerts: 200
  alertmanagerSpec:
    image:
      tag: {{ $tag.ALERTMANAGER_IMAGE | quote }}
      sha: {{ $sha.ALERTMANAGER_IMAGE | quote }}
    replicas: 1
    # UI is published through the Gateway (basic auth).
    externalUrl: {{ printf "https://alertmanager.%s" .Values.domain | quote }}
    retention: 24h
    resources:
      requests:
        cpu: 10m
        memory: 32Mi
      limits:
        memory: 128Mi

# --- Grafana ---
grafana:
  image:
    tag: {{ $tag.GRAFANA_IMAGE | quote }}
    sha: {{ $sha.GRAFANA_IMAGE | quote }}
  # No Helm test pod (it would need one more image).
  testFramework:
    enabled: false
  {{- $httpProxy := env "HTTP_PROXY" | default (env "http_proxy") }}
  {{- $httpsProxy := env "HTTPS_PROXY" | default (env "https_proxy") }}
  {{- $noProxy := env "NO_PROXY" | default (env "no_proxy") }}
  {{- if or $httpProxy $httpsProxy }}
  # Deployed behind an HTTP(S) proxy (HTTP_PROXY / HTTPS_PROXY were set):
  # the VictoriaLogs plugin is downloaded from grafana.com through it.
  # In-cluster addresses (datasources use <service>.<namespace>) bypass it.
  # Passed through a Secret rendered by the chart, so a password in the
  # proxy URL does not show up in the Deployment.
  envRenderSecret:
    HTTP_PROXY: {{ $httpProxy | quote }}
    HTTPS_PROXY: {{ $httpsProxy | quote }}
    NO_PROXY: {{ printf "%s,%s,%s" $noProxy .Values.monitoring.namespace .Values.logging.namespace | trimPrefix "," | quote }}
  {{- end }}
  # Admin credentials come from a Secret created on the first deploy by
  # scripts/ensure-grafana-admin.sh (random password, never in git).
  admin:
    existingSecret: {{ .Values.grafana.adminSecret | quote }}
    userKey: admin-user
    passwordKey: admin-password
  # Stateless: dashboards and datasources are provisioned from ConfigMaps.
  persistence:
    enabled: false
  defaultDashboardsTimezone: browser
  grafana.ini:
    server:
      root_url: {{ printf "https://grafana.%s" .Values.domain | quote }}
    analytics:
      check_for_updates: false
      check_for_plugin_updates: false
      reporting_enabled: false
    users:
      allow_sign_up: false
    auth.anonymous:
      enabled: false
    plugins:
      # Installed in the background on start-up: if grafana.com is not
      # reachable, Grafana still starts (only the VictoriaLogs datasource
      # stays unavailable; logs remain visible in vmui).
      preinstall: {{ printf "victoriametrics-logs-datasource@%s" .Values.versions.GRAFANA_VICTORIALOGS_PLUGIN_VERSION | quote }}
      preinstall_async: true
  resources:
    requests:
      cpu: 50m
      memory: 192Mi
    limits:
      memory: 512Mi
  sidecar:
    image:
      tag: {{ $tag.GRAFANA_SIDECAR_IMAGE | quote }}
      sha: {{ $sha.GRAFANA_SIDECAR_IMAGE | quote }}
    resources:
      requests:
        cpu: 10m
        memory: 48Mi
      limits:
        memory: 128Mi
    # Dashboards and datasources come only from ConfigMaps in Grafana's own
    # namespace (kube-prometheus-stack, observability-extras and the
    # VictoriaLogs chart all put them there); Secrets are never watched.
    dashboards:
      searchNamespace: {{ .Values.monitoring.namespace | quote }}
      resource: configmap
    datasources:
      searchNamespace: {{ .Values.monitoring.namespace | quote }}
      resource: configmap
  # Least privilege for the sidecars: a Role (not a ClusterRole) in the
  # monitoring namespace that can read ConfigMaps only. The chart's own Role
  # would also grant Secrets, so it is replaced by the one below.
  rbac:
    namespaced: true
    useExistingRole: grafana-configmap-reader
  extraObjects:
    - apiVersion: rbac.authorization.k8s.io/v1
      kind: Role
      metadata:
        name: grafana-configmap-reader
        namespace: {{ .Values.monitoring.namespace | quote }}
      rules:
        - apiGroups: [""]
          resources: ["configmaps"]
          verbs: ["get", "list", "watch"]

# --- Control plane ---
# kubeadm static pods; the node address is the API server address.
# controller-manager and scheduler listen on the node IP (kubeadm config) and
# serve HTTPS with a certificate they generate for themselves at start-up
# (not signed by the cluster CA), so the server certificate cannot be
# verified. The request still carries Prometheus' ServiceAccount token, which
# the components authenticate and authorise through the API server.
kubeControllerManager:
  endpoints:
    - {{ .Values.nodeIP | quote }}
  service:
    port: 10257
    targetPort: 10257
  serviceMonitor:
    https: true
    tlsConfig:
      insecureSkipVerify: true

kubeScheduler:
  endpoints:
    - {{ .Values.nodeIP | quote }}
  service:
    port: 10259
    targetPort: 10259
  serviceMonitor:
    https: true
    tlsConfig:
      insecureSkipVerify: true

# etcd metrics stay on 127.0.0.1:2381; they are published through
# kube-rbac-proxy (chart etcd-metrics-proxy), which brings its own Service
# and ServiceMonitor. Enabled here only for the etcd alerting rules and
# dashboard.
kubeEtcd:
  enabled: true
  service:
    enabled: false
  serviceMonitor:
    enabled: false

# Not deployed: Cilium replaces kube-proxy.
kubeProxy:
  enabled: false

# --- kube-state-metrics ---
kube-state-metrics:
  image:
    tag: {{ $tag.KUBE_STATE_METRICS_IMAGE | quote }}
    sha: {{ $digest.KUBE_STATE_METRICS_IMAGE | quote }}
  resources:
    requests:
      cpu: 10m
      memory: 48Mi
    limits:
      memory: 192Mi
  # The chart defaults without "secrets": no rule or dashboard uses the
  # kube_secret_* metrics, and without that collector kube-state-metrics
  # needs no read access to Secrets in every namespace.
  collectors:
    - certificatesigningrequests
    - configmaps
    - cronjobs
    - daemonsets
    - deployments
    - endpointslices
    - horizontalpodautoscalers
    - ingresses
    - jobs
    - leases
    - limitranges
    - mutatingwebhookconfigurations
    - namespaces
    - networkpolicies
    - nodes
    - persistentvolumeclaims
    - persistentvolumes
    - poddisruptionbudgets
    - pods
    - replicasets
    - replicationcontrollers
    - resourcequotas
    - services
    - statefulsets
    - storageclasses
    - validatingwebhookconfigurations
    - volumeattachments
  # Gateway API objects as metrics: status conditions of every Gateway
  # (gatewayapi_gateway_status{type="Programmed"}), used by the
  # GatewayNotProgrammed alert.
  rbac:
    extraRules:
      - apiGroups: ["gateway.networking.k8s.io"]
        resources: ["gateways"]
        verbs: ["list", "watch"]
  customResourceState:
    enabled: true
    config:
      kind: CustomResourceStateMetrics
      spec:
        resources:
          - groupVersionKind:
              group: gateway.networking.k8s.io
              version: v1
              kind: Gateway
            metricNamePrefix: gatewayapi_gateway
            labelsFromPath:
              name: [metadata, name]
              namespace: [metadata, namespace]
            metrics:
              - name: status
                help: "Gateway status condition (1 = True, 0 = False)"
                each:
                  type: Gauge
                  gauge:
                    path: [status, conditions]
                    labelsFromPath:
                      type: [type]
                    valueFrom: [status]

# --- node-exporter ---
# Needs the host network and PID namespace: lives in its own namespace with
# Pod Security "privileged", so "monitoring" itself can stay "restricted".
# node-exporter itself listens on 127.0.0.1 only; the node port 9100 is
# served by kube-rbac-proxy: TLS (certificate from the demo CA, see
# extraManifests below), and a request is forwarded only if its bearer token
# may "get services/<name>/<name>" in this namespace (SubjectAccessReview);
# only Prometheus' ServiceAccount is allowed to. Without a token: 401.
prometheus-node-exporter:
  namespaceOverride: {{ .Values.monitoring.nodeNamespace | quote }}
  # The tag already names the distroless variant.
  image:
    tag: {{ $tag.NODE_EXPORTER_IMAGE | quote }}
    distroless: false
    digest: {{ $digest.NODE_EXPORTER_IMAGE | quote }}
  resources:
    requests:
      cpu: 10m
      memory: 24Mi
    limits:
      memory: 64Mi
  securityContext:
    fsGroup: 65534
    runAsGroup: 65534
    runAsNonRoot: true
    runAsUser: 65534
    seccompProfile:
      type: RuntimeDefault
  containerSecurityContext:
    allowPrivilegeEscalation: false
    readOnlyRootFilesystem: true
    capabilities:
      drop:
        - ALL
  kubeRBACProxy:
    enabled: true
    image:
      tag: {{ printf "v%s" .Values.versions.KUBE_RBAC_PROXY_VERSION | quote }}
      sha: {{ .Values.versions.KUBE_RBAC_PROXY_DIGEST | trimPrefix "sha256:" | quote }}
    tls:
      enabled: true
    containerSecurityContext:
      allowPrivilegeEscalation: false
      readOnlyRootFilesystem: true
      capabilities:
        drop:
          - ALL
    resources:
      requests:
        cpu: 5m
        memory: 16Mi
      limits:
        memory: 64Mi
  tlsSecret:
    enabled: true
    secretName: {{ .Values.nodeExporter.tlsSecret | quote }}
    volumeName: tls
  prometheus:
    monitor:
      scheme: https
      # Prometheus' own ServiceAccount token (projected, short-lived,
      # rotated by the kubelet), not a long-lived token Secret.
      bearerTokenFile: /var/run/secrets/kubernetes.io/serviceaccount/token
      tlsConfig:
        serverName: {{ printf "%s.%s.svc" .Values.nodeExporter.name .Values.monitoring.nodeNamespace | quote }}
        ca:
          secret:
            name: {{ .Values.nodeExporter.tlsSecret | quote }}
            key: ca.crt

extraManifests:
  # Serving certificate of the node-exporter proxy.
  - apiVersion: cert-manager.io/v1
    kind: Certificate
    metadata:
      name: {{ .Values.nodeExporter.tlsSecret | quote }}
      namespace: {{ .Values.monitoring.nodeNamespace | quote }}
    spec:
      secretName: {{ .Values.nodeExporter.tlsSecret | quote }}
      # No commonName: the Service DNS name is longer than its 64-byte limit.
      dnsNames:
        - {{ printf "%s.%s.svc" .Values.nodeExporter.name .Values.monitoring.nodeNamespace | quote }}
      usages:
        - server auth
      privateKey:
        algorithm: ECDSA
        size: 256
      issuerRef:
        group: cert-manager.io
        kind: ClusterIssuer
        name: demo-ca
  # The permission kube-rbac-proxy checks (its config file asks for
  # "get services/<name>/<name>"), granted to Prometheus only.
  - apiVersion: rbac.authorization.k8s.io/v1
    kind: Role
    metadata:
      name: node-exporter-metrics-reader
      namespace: {{ .Values.monitoring.nodeNamespace | quote }}
    rules:
      - apiGroups: [""]
        resources: [{{ printf "services/%s" .Values.nodeExporter.name | quote }}]
        resourceNames: [{{ .Values.nodeExporter.name | quote }}]
        verbs: ["get"]
  - apiVersion: rbac.authorization.k8s.io/v1
    kind: RoleBinding
    metadata:
      name: node-exporter-metrics-reader
      namespace: {{ .Values.monitoring.nodeNamespace | quote }}
    roleRef:
      apiGroup: rbac.authorization.k8s.io
      kind: Role
      name: node-exporter-metrics-reader
    subjects:
      - kind: ServiceAccount
        name: {{ .Values.monitoring.prometheusServiceAccount | quote }}
        namespace: {{ .Values.monitoring.namespace | quote }}
