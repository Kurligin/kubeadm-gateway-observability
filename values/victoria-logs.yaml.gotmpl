# VictoriaLogs single node: log storage for Fluentd, LogsQL API and the
# built-in web UI (vmui, published through the Gateway as logs.<domain>).
server:
  fullnameOverride: {{ .Values.logging.service | quote }}
  image:
    # quay.io: the same image without Docker Hub's anonymous pull limit.
    registry: quay.io
    # tag@digest (the chart strips the digest for its version label).
    tag: {{ printf "v%s@%s" .Values.versions.VICTORIA_LOGS_VERSION .Values.versions.VICTORIA_LOGS_DIGEST | quote }}
  # Seven days of logs, and never more than 2 GiB on disk (the oldest days
  # are dropped first), so the node disk never fills up.
  retentionPeriod: 7d
  retentionDiskSpaceUsage: 2
  persistentVolume:
    enabled: true
    storageClassName: local-path
    size: 3Gi
  resources:
    requests:
      cpu: 20m
      memory: 64Mi
    limits:
      memory: 512Mi
  # Pod Security "restricted": non-root, no capabilities, seccomp.
  podSecurityContext:
    enabled: true
    fsGroup: 2000
    runAsNonRoot: true
    runAsUser: 1000
    runAsGroup: 2000
    seccompProfile:
      type: RuntimeDefault
  securityContext:
    enabled: true
    allowPrivilegeEscalation: false
    readOnlyRootFilesystem: true
    capabilities:
      drop:
        - ALL
  serviceMonitor:
    enabled: {{ .Values.serviceMonitors }}

# Upstream VictoriaLogs dashboard. Rendered into Grafana's namespace: the
# Grafana sidecar reads ConfigMaps from there only.
dashboards:
  enabled: true
  namespace: {{ .Values.monitoring.namespace | quote }}
  labels:
    grafana_dashboard: "1"
