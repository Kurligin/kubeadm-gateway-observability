# VictoriaLogs single node: log storage for Fluentd, LogsQL API and the
# built-in web UI (vmui, published through the Gateway as logs.<domain>).
server:
  fullnameOverride: {{ .Values.logging.service | quote }}
  image:
    tag: {{ printf "v%s" .Values.versions.VICTORIA_LOGS_VERSION | quote }}
  # Seven days of logs, and never more than 4 GiB on disk (the oldest days
  # are dropped first), so the node disk never fills up.
  retentionPeriod: 7d
  retentionDiskSpaceUsage: 4
  persistentVolume:
    enabled: true
    storageClassName: local-path
    size: 5Gi
  resources:
    requests:
      cpu: 20m
      memory: 64Mi
    limits:
      memory: 512Mi
  # Pod Security "restricted": non-root, no capabilities, seccomp.
  podSecurityContext:
    enabled: true
    fsGroup: 2000
    runAsNonRoot: true
    runAsUser: 1000
    runAsGroup: 2000
    seccompProfile:
      type: RuntimeDefault
  securityContext:
    enabled: true
    allowPrivilegeEscalation: false
    readOnlyRootFilesystem: true
    capabilities:
      drop:
        - ALL
  serviceMonitor:
    enabled: {{ .Values.serviceMonitors }}

# Upstream VictoriaLogs dashboard, picked up by the Grafana sidecar.
dashboards:
  enabled: true
  labels:
    grafana_dashboard: "1"
