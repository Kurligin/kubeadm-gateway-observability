# CRDs are installed and upgraded with the chart and kept on uninstall
# (removing them would delete every Certificate in the cluster).
crds:
  enabled: true
  keep: true

# Images pinned by digest (the tags default to the chart version).
image:
  digest: {{ .Values.versions.CERT_MANAGER_CONTROLLER_DIGEST | quote }}
acmesolver:
  image:
    digest: {{ .Values.versions.CERT_MANAGER_ACMESOLVER_DIGEST | quote }}
startupapicheck:
  image:
    digest: {{ .Values.versions.CERT_MANAGER_STARTUPAPICHECK_DIGEST | quote }}

prometheus:
  enabled: true
  servicemonitor:
    enabled: {{ .Values.serviceMonitors }}

resources:
  requests:
    cpu: 10m
    memory: 64Mi
  limits:
    memory: 256Mi

webhook:
  image:
    digest: {{ .Values.versions.CERT_MANAGER_WEBHOOK_DIGEST | quote }}
  resources:
    requests:
      cpu: 10m
      memory: 32Mi
    limits:
      memory: 128Mi

cainjector:
  image:
    digest: {{ .Values.versions.CERT_MANAGER_CAINJECTOR_DIGEST | quote }}
  resources:
    requests:
      cpu: 10m
      memory: 64Mi
    limits:
      memory: 256Mi
