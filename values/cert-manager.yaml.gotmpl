# CRDs are installed and upgraded with the chart and kept on uninstall
# (removing them would delete every Certificate in the cluster).
crds:
  enabled: true
  keep: true

prometheus:
  enabled: true
  servicemonitor:
    enabled: {{ .Values.serviceMonitors }}

resources:
  requests:
    cpu: 10m
    memory: 64Mi
  limits:
    memory: 256Mi

webhook:
  resources:
    requests:
      cpu: 10m
      memory: 32Mi
    limits:
      memory: 128Mi

cainjector:
  resources:
    requests:
      cpu: 10m
      memory: 64Mi
    limits:
      memory: 256Mi
