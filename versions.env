PROMETHEUS_OPERATOR_CRDS_VERSION=32.0.1
PROMETHEUS_OPERATOR_CRDS_CHART_SHA256=c9bf364eb4e5fc25d314e3e6e93acfe54a637bd4e149e82bb6bd2c962cea46c7
# Images of kube-prometheus-stack (tags: the defaults of the chart above).
PROMETHEUS_OPERATOR_IMAGE=v0.94.1@sha256:7c88d4e7bae63bd8d0f8da986054337c23b4472fa8d3c6817f5bc4b8407a2d6a
PROMETHEUS_CONFIG_RELOADER_IMAGE=v0.94.1@sha256:06b52bd4dbe3ed6dd5905aadaf8b9987d9da4c31d37bb86deaadae68cee2d26b
PROMETHEUS_IMAGE=v3.15.0-distroless@sha256:b2a413d5a03ea6a76782a508d1c7947440bba3b973931a25676e278431891b01
ALERTMANAGER_IMAGE=v0.34.1@sha256:e9733bafb1bdef9b00e25a21f8f99dc26a22224bf16641ad754d1649f4c3357a
# Thanos sidecar: only referenced by the operator (no Thanos here), never run.
THANOS_IMAGE=v0.42.4@sha256:b567818fe608067eb0f1d7c2c4fe361e7ad83c8a256234c97685f1d0bf670cc8
GRAFANA_IMAGE=13.2.3-distroless@sha256:202e5d5b3f8499e70ccac7991eea6d7da72d2790eb2e0597e7987acf724e7180
GRAFANA_SIDECAR_IMAGE=2.11.2@sha256:2912be006f62f9ea080194cf6d3afcd90daead8d101d0ba686a137a849f6a4f6
KUBE_STATE_METRICS_IMAGE=v2.20.0@sha256:42cfe3723a5f058171c627537fb57a3ea0f26e4380fa18555a95cb1a1b4cfc5b
NODE_EXPORTER_IMAGE=v1.12.1-distroless@sha256:8c9bac11973b94b59be88d6e11fee4429aa743c8846cdc75d65b18db33f6a106
# Grafana datasource plugin for VictoriaLogs, installed by Grafana from the
# GitHub release of VictoriaMetrics/victorialogs-datasource (the same
# archive grafana.com serves, sha256 8204d097...eeef0). The plugin is signed
# by VictoriaMetrics; Grafana checks the signature and the checksum of every
# file in it with its built-in key before loading it.
GRAFANA_VICTORIALOGS_PLUGIN_VERSION=0.32.0
# Proxy in front of the etcd metrics endpoint (quay.io/brancz/kube-rbac-proxy).
KUBE_RBAC_PROXY_VERSION=0.22.1
KUBE_RBAC_PROXY_DIGEST=sha256:e8cad21b2f9ad0302f1ec972c555a1d916f51aae6003da3cd2554d5f29bb9bc4
# Logs: VictoriaLogs single node (chart victoria-logs-single, image
# victoriametrics/victoria-logs) and Fluentd.
VICTORIA_LOGS_CHART_VERSION=0.13.8
VICTORIA_LOGS_CHART_SHA256=78dffd3b76238d7dd605bf2692fd113576f0e2f7b0cb6316afca5344a46fe3d1
VICTORIA_LOGS_VERSION=1.51.1
VICTORIA_LOGS_DIGEST=sha256:a3ecc79c2a1f3ea3b03ac517dcf45c8f6ecbd65629acfd9140c335e867b13522
# fluent/fluentd-kubernetes-daemonset, "debian-forward" variant: Fluentd
# 1.19.3 with the kubernetes_metadata, prometheus, concat and CRI parser
# plugins; logs are sent by the core out_http plugin.
FLUENTD_IMAGE_TAG=v1.19.3-debian-forward-1.1
FLUENTD_DIGEST=sha256:358ec8e09ca57120e557b836de0a586cc51dd6e62e237b5e96612bdb6f7831d9
# Traces: VictoriaTraces single node (chart victoria-traces-single, image
# victoriametrics/victoria-traces): OTLP from the Envoy proxies, Jaeger
# query API for Grafana. The chart's default is v0.11.0; v0.11.1 is its
# patch release (security fix of the Go toolchain, VictoriaLogs storage
# v1.52.0).
VICTORIA_TRACES_CHART_VERSION=0.1.11
VICTORIA_TRACES_CHART_SHA256=59471db9c6e053fc740b1ad0eb6365dc872bba3f0c9e06f5780ddde9655c9e88
VICTORIA_TRACES_VERSION=0.11.1
VICTORIA_TRACES_DIGEST=sha256:b8e13852fa320debb9c1124f7987f62a1fd048c9de50a2ed840c390e21e232ed
TRACING_NAMESPACE=tracing
# TRACING=auto (the default, see scripts/tracing-mode.sh) turns tracing on
# when the control plane node has at least this much memory (MiB, node
# capacity as reported by the kubelet; a "6 GB" VM reports ~5.8 GiB).
TRACING_AUTO_MIN_MEMORY_MIB=5632
# ... and at least this much disk (GiB, node capacity "ephemeral-storage",
# the root filesystem): traces add up to ~1 GiB to the ~16 GB peak, and
# kubelet starts removing images at 85 % of the disk.
TRACING_AUTO_MIN_DISK_GIB=22
# Resource metrics API for `kubectl top` and autoscalers (chart
# metrics-server of kubernetes-sigs, image registry.k8s.io/metrics-server).
METRICS_SERVER_CHART_VERSION=3.14.0
METRICS_SERVER_CHART_SHA256=c2ca1185c01e6e7f53dd1b7d131f0c9b3fa50e003ed068b784563a1b5a3422a1
METRICS_SERVER_VERSION=0.9.0
METRICS_SERVER_DIGEST=sha256:d9862115e7c7881280d3d75ca26bda8ffc0fc213315979575bf23ce9826205c0
# Namespaces and the Grafana admin Secret (generated on first deploy by
# scripts/ensure-grafana-admin.sh, never stored in git).
MONITORING_NAMESPACE=monitoring
LOGGING_NAMESPACE=logging
GRAFANA_ADMIN_SECRET=grafana-admin
GRAFANA_ADMIN_USER=admin

# --- Lint tooling ---
# Installed into .venv/bin by `make lint-deps` (scripts/install-tool.sh),
# together with helm and helmfile of the versions above.
# promtool (rules check), same version as the Prometheus deployed by
# kube-prometheus-stack above.
PROMTOOL_VERSION=3.15.0
PROMTOOL_SHA256=2a542df32eac02ee17b9d844fb2aa1de00dafa5476579ba8a3ba862e9d572ea0
# Schema validation of the rendered manifests (scripts/check-manifests.sh).
KUBECONFORM_VERSION=0.8.0
KUBECONFORM_SHA256=9bc2bffbf71f261128533edaf912153948b7ff238f9a531ae6d34466ec287883
# Kubernetes JSON schemas for kubeconform: commit of
# github.com/yannh/kubernetes-json-schema that has v${K8S_VERSION}.
KUBERNETES_JSON_SCHEMA_COMMIT=8df8a883b68a24a104b4a9e43c1288090ae60b3b
# Misconfiguration scan of the rendered manifests (built-in checks only, no
# check bundle download: results depend on this version alone).
TRIVY_VERSION=0.74.0
TRIVY_SHA256=2ae6fe3ee734b7fdf11335663e18c75ea12dccc76062f09f164a3b0f8be4371a
# Best-practice checks of our own charts.
KUBE_LINTER_VERSION=0.8.3
KUBE_LINTER_SHA256=1a6d8419b11971372971fdbc22682b684ebfb7cf1c39591662d1b6ca736c41df
