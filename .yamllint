---
extends: default

ignore: |
  .venv/
  .ansible/
  ansible/collections/
  charts/*/templates/
  # Vendored upstream chart, kept byte-for-byte.
  charts/local-path-provisioner/
  *.gotmpl

rules:
  line-length:
    max: 140
  truthy:
    allowed-values: ["true", "false"]
    check-keys: false
  comments:
    min-spaces-from-content: 1
  comments-indentation: false
  braces:
    max-spaces-inside: 1
  octal-values:
    forbid-implicit-octal: true
    forbid-explicit-octal: true
