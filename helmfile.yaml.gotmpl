# Cluster add-ons, installed after `make cluster`.
# Run through `make platform` (helmfile apply: diff first, upgrade only what changed).
#
# Versions come from versions.env. The node address (Cilium k8sServiceHost)
# always comes from the API server URL in the current kubeconfig, which
# kubeadm sets to the advertise address: the cluster cannot change it. NODE_IP,
# if set, must match it; without a kubeconfig (offline rendering) NODE_IP is
# used as is.
{{- $versions := dict }}
{{- range $line := readFile "versions.env" | splitList "\n" }}
{{-   $line = trim $line }}
{{-   if and (contains "=" $line) (not (hasPrefix "#" $line)) }}
{{-     $kv := splitn "=" 2 $line }}
{{-     $_ := set $versions $kv._0 $kv._1 }}
{{-   end }}
{{- end }}
{{- $requestedIP := env "NODE_IP" }}
{{- $server := exec "sh" (list "-c" "kubectl config view --minify --output 'jsonpath={.clusters[0].cluster.server}' 2>/dev/null || true") | trim }}
{{- $nodeIP := $server | trimPrefix "https://" | splitList ":" | first }}
{{- if eq $nodeIP "" }}
{{-   if eq $requestedIP "" }}
{{-     fail "No kubeconfig with a cluster found and NODE_IP is not set: run `make cluster` first (or set NODE_IP to render offline)." }}
{{-   end }}
{{-   $nodeIP = $requestedIP }}
{{- else if and (ne $requestedIP "") (ne $requestedIP $nodeIP) }}
{{-   fail (printf "The cluster in the current kubeconfig was created with API server address %s, but NODE_IP=%s. A kubeadm cluster cannot change its address: drop NODE_IP, or recreate the cluster with `make destroy FORCE=1` and deploy again." $nodeIP $requestedIP) }}
{{- end }}

environments:
  default:
    values:
      - nodeIP: {{ $nodeIP | quote }}
        versions:
{{ $versions | toYaml | indent 10 }}
        # Prometheus Operator CRDs are installed together with
        # kube-prometheus-stack; ServiceMonitors stay off until then.
        serviceMonitors: false
        # Demo domain served by the Gateway (certificate: <domain>, *.<domain>).
        domain: demo.local
        # Gateway "public" and its routes live in this namespace.
        gateway:
          namespace: {{ $versions.GATEWAY_NAMESPACE | quote }}
          name: public
        # htpasswd Secret (gateway namespace) for basic auth on UI routes,
        # see versions.env.
        basicAuth:
          secretName: {{ $versions.BASIC_AUTH_SECRET | quote }}
          username: {{ $versions.BASIC_AUTH_USER | quote }}

---
helmDefaults:
  wait: true
  waitForJobs: true
  timeout: 900
  historyMax: 5
  createNamespace: true

repositories:
  - name: cilium
    url: https://helm.cilium.io
  - name: jetstack
    url: https://charts.jetstack.io

releases:
  - name: cilium
    namespace: kube-system
    chart: cilium/cilium
    version: {{ .Values.versions.CILIUM_VERSION | quote }}
    values:
      - values/cilium.yaml.gotmpl

  # kubeadm ships no StorageClass; Prometheus and VictoriaLogs need PVCs.
  # No official Helm repository exists, so the upstream chart of the same
  # release is vendored in charts/local-path-provisioner.
  - name: local-path-provisioner
    namespace: local-path-storage
    chart: ./charts/local-path-provisioner
    needs:
      - kube-system/cilium
    values:
      - values/local-path-provisioner.yaml.gotmpl

  # Namespaces with Pod Security Admission labels. They must exist before the
  # releases that live in them (Helm keeps its release record there).
  - name: namespaces
    namespace: kube-system
    chart: ./charts/namespaces
    needs:
      - kube-system/cilium
    values:
      - values/namespaces.yaml.gotmpl

  # CRDs come with the chart (crds.enabled); the post-install API check job
  # waits until the webhook serves requests, so issuers can be created next.
  - name: cert-manager
    namespace: cert-manager
    chart: jetstack/cert-manager
    version: {{ printf "v%s" .Values.versions.CERT_MANAGER_VERSION | quote }}
    needs:
      - kube-system/cilium
    values:
      - values/cert-manager.yaml.gotmpl

  # Self-signed root -> CA ClusterIssuer "demo-ca". The resources use
  # cert-manager CRDs, so the first diff runs without cluster validation.
  - name: pki
    namespace: cert-manager
    chart: ./charts/pki
    disableValidationOnInstall: true
    needs:
      - cert-manager/cert-manager
    values:
      - values/pki.yaml.gotmpl

  # Controller only; its bundled CRDs are disabled. The Gateway API
  # (standard channel) and Envoy Gateway CRDs of the same version are applied
  # by the presync hook instead: CRDs in a chart's crds/ directory are only
  # created on the first install and never upgraded. The hook runs whenever
  # this release is installed or changed, e.g. on an ENVOY_GATEWAY_VERSION bump.
  - name: envoy-gateway
    namespace: envoy-gateway-system
    chart: oci://docker.io/envoyproxy/gateway-helm
    version: {{ printf "v%s" .Values.versions.ENVOY_GATEWAY_VERSION | quote }}
    needs:
      - kube-system/namespaces
    values:
      - values/envoy-gateway.yaml
    hooks:
      - events: ["presync"]
        showlogs: true
        command: ./scripts/apply-gateway-crds.sh
        args:
          - {{ printf "v%s" .Values.versions.ENVOY_GATEWAY_VERSION | quote }}
          - values/envoy-gateway-crds.yaml

  # Angie web-v1 / web-v2 behind the Gateway.
  - name: demo-app
    namespace: demo
    chart: ./charts/demo-app
    needs:
      - kube-system/namespaces
    values:
      - values/demo-app.yaml.gotmpl

  # EnvoyProxy, GatewayClass, Gateway, TLS certificate, routes and policies.
  - name: gateway
    namespace: {{ .Values.gateway.namespace }}
    chart: ./charts/gateway
    disableValidationOnInstall: true
    needs:
      - kube-system/namespaces
      - cert-manager/pki
      - envoy-gateway-system/envoy-gateway
      - demo/demo-app
    values:
      - values/gateway.yaml.gotmpl
    hooks:
      # Creates the Secret before the first install, so the policies that use
      # it never see it missing. Hooks run only when the release changes;
      # `make platform` calls the same (idempotent) script after every apply,
      # which also restores a deleted Secret.
      - events: ["presync"]
        showlogs: true
        command: ./scripts/ensure-basic-auth.sh
        args:
          - {{ .Values.gateway.namespace | quote }}
          - {{ .Values.basicAuth.secretName | quote }}
          - {{ .Values.basicAuth.username | quote }}
      # Helm does not wait for custom resources; finish only when Envoy is
      # deployed and the Gateway has its address.
      - events: ["postsync"]
        showlogs: true
        command: kubectl
        args:
          - {{ printf "--namespace=%s" .Values.gateway.namespace | quote }}
          - wait
          - --for=condition=Programmed
          - --timeout=300s
          - {{ printf "gateway/%s" .Values.gateway.name | quote }}
