# Cluster add-ons, installed after `make cluster`.
# Run through `make platform` (helmfile apply: diff first, upgrade only what changed).
#
# Versions come from versions.env. The node address (Cilium k8sServiceHost)
# always comes from the API server URL in the current kubeconfig, which
# kubeadm sets to the advertise address: the cluster cannot change it. NODE_IP,
# if set, must match it; without a kubeconfig (offline rendering) NODE_IP is
# used as is.
{{- $versions := dict }}
{{- range $line := readFile "versions.env" | splitList "\n" }}
{{-   $line = trim $line }}
{{-   if and (contains "=" $line) (not (hasPrefix "#" $line)) }}
{{-     $kv := splitn "=" 2 $line }}
{{-     $_ := set $versions $kv._0 $kv._1 }}
{{-   end }}
{{- end }}
{{- $requestedIP := env "NODE_IP" }}
{{- $server := exec "sh" (list "-c" "kubectl config view --minify --output 'jsonpath={.clusters[0].cluster.server}' 2>/dev/null || true") | trim }}
{{- $nodeIP := $server | trimPrefix "https://" | splitList ":" | first }}
{{- if eq $nodeIP "" }}
{{-   if eq $requestedIP "" }}
{{-     fail "No kubeconfig with a cluster found and NODE_IP is not set: run `make cluster` first (or set NODE_IP to render offline)." }}
{{-   end }}
{{-   $nodeIP = $requestedIP }}
{{- else if and (ne $requestedIP "") (ne $requestedIP $nodeIP) }}
{{-   fail (printf "The cluster in the current kubeconfig was created with API server address %s, but NODE_IP=%s. A kubeadm cluster cannot change its address: drop NODE_IP, or recreate the cluster with `make destroy FORCE=1` and deploy again." $nodeIP $requestedIP) }}
{{- end }}

environments:
  default:
    values:
      - nodeIP: {{ $nodeIP | quote }}
        versions:
{{ $versions | toYaml | indent 10 }}
        # ServiceMonitors/PodMonitors of every chart. The Prometheus Operator
        # CRDs are the very first release, so this can be on from the start.
        serviceMonitors: true
        # Demo domain served by the Gateway (certificate: <domain>, *.<domain>).
        domain: demo.local
        # Gateway "public" and its routes live in this namespace.
        gateway:
          namespace: {{ $versions.GATEWAY_NAMESPACE | quote }}
          name: public
        # htpasswd Secret (gateway namespace) for basic auth on UI routes,
        # see versions.env.
        basicAuth:
          secretName: {{ $versions.BASIC_AUTH_SECRET | quote }}
          username: {{ $versions.BASIC_AUTH_USER | quote }}
        # Prometheus, Alertmanager, Grafana and kube-state-metrics live in
        # "namespace"; host-level agents (node-exporter, etcd metrics proxy)
        # in "nodeNamespace" (Pod Security "privileged").
        monitoring:
          namespace: {{ $versions.MONITORING_NAMESPACE | quote }}
          nodeNamespace: {{ printf "%s-node" $versions.MONITORING_NAMESPACE | quote }}
        # VictoriaLogs in "namespace", Fluentd in "nodeNamespace".
        logging:
          namespace: {{ $versions.LOGGING_NAMESPACE | quote }}
          nodeNamespace: {{ printf "%s-node" $versions.LOGGING_NAMESPACE | quote }}
          # VictoriaLogs Service (fullnameOverride) and its HTTP port.
          service: victoria-logs
          port: 9428
        # Grafana admin credentials (Secret in the monitoring namespace).
        grafana:
          adminSecret: {{ $versions.GRAFANA_ADMIN_SECRET | quote }}
          adminUser: {{ $versions.GRAFANA_ADMIN_USER | quote }}

---
helmDefaults:
  wait: true
  waitForJobs: true
  timeout: 900
  historyMax: 5
  createNamespace: true

repositories:
  - name: cilium
    url: https://helm.cilium.io
  - name: jetstack
    url: https://charts.jetstack.io
  - name: prometheus-community
    url: https://prometheus-community.github.io/helm-charts
  - name: vm
    url: https://victoriametrics.github.io/helm-charts

releases:
  # Prometheus Operator CRDs (ServiceMonitor, PodMonitor, PrometheusRule, ...)
  # first: almost every chart below ships a ServiceMonitor, Cilium included.
  # CRDs need no running pods, so this works before the CNI is up. As a
  # regular release (CRDs in templates/), they are upgraded with the chart.
  - name: prometheus-operator-crds
    namespace: kube-system
    chart: prometheus-community/prometheus-operator-crds
    version: {{ .Values.versions.PROMETHEUS_OPERATOR_CRDS_VERSION | quote }}

  - name: cilium
    namespace: kube-system
    chart: cilium/cilium
    version: {{ .Values.versions.CILIUM_VERSION | quote }}
    # Ships ServiceMonitors: the first diff runs before any CRD exists.
    disableValidationOnInstall: true
    needs:
      - kube-system/prometheus-operator-crds
    values:
      - values/cilium.yaml.gotmpl

  # kubeadm ships no StorageClass; Prometheus and VictoriaLogs need PVCs.
  # No official Helm repository exists, so the upstream chart of the same
  # release is vendored in charts/local-path-provisioner.
  - name: local-path-provisioner
    namespace: local-path-storage
    chart: ./charts/local-path-provisioner
    needs:
      - kube-system/cilium
    values:
      - values/local-path-provisioner.yaml.gotmpl

  # Namespaces with Pod Security Admission labels. They must exist before the
  # releases that live in them (Helm keeps its release record there).
  - name: namespaces
    namespace: kube-system
    chart: ./charts/namespaces
    needs:
      - kube-system/cilium
    values:
      - values/namespaces.yaml.gotmpl

  # CRDs come with the chart (crds.enabled); the post-install API check job
  # waits until the webhook serves requests, so issuers can be created next.
  - name: cert-manager
    namespace: cert-manager
    chart: jetstack/cert-manager
    version: {{ printf "v%s" .Values.versions.CERT_MANAGER_VERSION | quote }}
    disableValidationOnInstall: true
    needs:
      - kube-system/cilium
    values:
      - values/cert-manager.yaml.gotmpl

  # Self-signed root -> CA ClusterIssuer "demo-ca". The resources use
  # cert-manager CRDs, so the first diff runs without cluster validation.
  - name: pki
    namespace: cert-manager
    chart: ./charts/pki
    disableValidationOnInstall: true
    needs:
      - cert-manager/cert-manager
    values:
      - values/pki.yaml.gotmpl

  # Controller only; its bundled CRDs are disabled. The Gateway API
  # (standard channel) and Envoy Gateway CRDs of the same version are applied
  # by the presync hook instead: CRDs in a chart's crds/ directory are only
  # created on the first install and never upgraded. The hook runs whenever
  # this release is installed or changed, e.g. on an ENVOY_GATEWAY_VERSION bump.
  - name: envoy-gateway
    namespace: envoy-gateway-system
    chart: oci://docker.io/envoyproxy/gateway-helm
    version: {{ printf "v%s" .Values.versions.ENVOY_GATEWAY_VERSION | quote }}
    needs:
      - kube-system/namespaces
    values:
      - values/envoy-gateway.yaml
    hooks:
      - events: ["presync"]
        showlogs: true
        command: ./scripts/apply-gateway-crds.sh
        args:
          - {{ printf "v%s" .Values.versions.ENVOY_GATEWAY_VERSION | quote }}
          - values/envoy-gateway-crds.yaml

  # Prometheus, Alertmanager, Grafana, node-exporter, kube-state-metrics.
  # Prometheus needs a PVC; kube-state-metrics exports Gateway API objects,
  # so their CRDs (envoy-gateway presync hook) come first. Uses Prometheus
  # Operator CRDs, so the first diff runs without cluster validation (same
  # for every release below that ships a ServiceMonitor or rules).
  - name: kube-prometheus-stack
    namespace: {{ .Values.monitoring.namespace }}
    chart: prometheus-community/kube-prometheus-stack
    version: {{ .Values.versions.KUBE_PROMETHEUS_STACK_VERSION | quote }}
    disableValidationOnInstall: true
    needs:
      - kube-system/namespaces
      - local-path-storage/local-path-provisioner
      - envoy-gateway-system/envoy-gateway
    values:
      - values/kube-prometheus-stack.yaml.gotmpl
    hooks:
      # Grafana admin Secret before the first install (Grafana reads it via
      # admin.existingSecret); `make platform` re-checks it after every apply.
      - events: ["presync"]
        showlogs: true
        command: ./scripts/ensure-grafana-admin.sh
        args:
          - {{ .Values.monitoring.namespace | quote }}
          - {{ .Values.grafana.adminSecret | quote }}
          - {{ .Values.grafana.adminUser | quote }}

  # kube-rbac-proxy for etcd metrics: TLS certificate from the demo CA.
  - name: etcd-metrics-proxy
    namespace: {{ .Values.monitoring.nodeNamespace }}
    chart: ./charts/etcd-metrics-proxy
    disableValidationOnInstall: true
    needs:
      - kube-system/namespaces
      - cert-manager/pki
    values:
      - values/etcd-metrics-proxy.yaml.gotmpl
    hooks:
      # See the "logging" release: wait for the DaemonSet rollout.
      - events: ["postsync"]
        showlogs: true
        command: kubectl
        args:
          - {{ printf "--namespace=%s" .Values.monitoring.nodeNamespace | quote }}
          - rollout
          - status
          - --timeout=300s
          - daemonset/etcd-metrics-proxy

  # Log storage with LogsQL API and web UI.
  - name: victoria-logs
    namespace: {{ .Values.logging.namespace }}
    chart: vm/victoria-logs-single
    version: {{ .Values.versions.VICTORIA_LOGS_CHART_VERSION | quote }}
    disableValidationOnInstall: true
    needs:
      - kube-system/namespaces
      - local-path-storage/local-path-provisioner
    values:
      - values/victoria-logs.yaml.gotmpl

  # Fluentd DaemonSet: container logs -> VictoriaLogs.
  - name: logging
    namespace: {{ .Values.logging.nodeNamespace }}
    chart: ./charts/logging
    disableValidationOnInstall: true
    needs:
      - kube-system/namespaces
      - {{ printf "%s/victoria-logs" .Values.logging.namespace }}
    values:
      - values/logging.yaml.gotmpl
    hooks:
      # Helm's --wait accepts a DaemonSet on a single node with zero ready
      # pods (maxUnavailable 1); wait for the rollout explicitly.
      - events: ["postsync"]
        showlogs: true
        command: kubectl
        args:
          - {{ printf "--namespace=%s" .Values.logging.nodeNamespace | quote }}
          - rollout
          - status
          - --timeout=300s
          - daemonset/fluentd

  # Envoy scrape targets, alerting rules, dashboards, VictoriaLogs datasource.
  # Needs only the CRDs and namespaces, so it is installed before Prometheus
  # starts and is part of its very first configuration (a later change
  # reaches Prometheus only after the kubelet refreshes the mounted config
  # Secret, which can take minutes). Grafana sidecars pick up the dashboard
  # and datasource ConfigMaps whenever they appear.
  - name: observability-extras
    namespace: {{ .Values.monitoring.namespace }}
    chart: ./charts/observability-extras
    disableValidationOnInstall: true
    needs:
      - kube-system/namespaces
      - kube-system/prometheus-operator-crds
    values:
      - values/observability-extras.yaml.gotmpl

  # Angie web-v1 / web-v2 behind the Gateway.
  - name: demo-app
    namespace: demo
    chart: ./charts/demo-app
    disableValidationOnInstall: true
    needs:
      - kube-system/namespaces
    values:
      - values/demo-app.yaml.gotmpl

  # EnvoyProxy, GatewayClass, Gateway, TLS certificate, routes and policies.
  - name: gateway
    namespace: {{ .Values.gateway.namespace }}
    chart: ./charts/gateway
    disableValidationOnInstall: true
    needs:
      - kube-system/namespaces
      - cert-manager/pki
      - envoy-gateway-system/envoy-gateway
      - demo/demo-app
      # UI routes (uiRoutes) point to their Services.
      - {{ printf "%s/kube-prometheus-stack" .Values.monitoring.namespace }}
      - {{ printf "%s/victoria-logs" .Values.logging.namespace }}
    values:
      - values/gateway.yaml.gotmpl
    hooks:
      # Creates the Secret before the first install, so the policies that use
      # it never see it missing. Hooks run only when the release changes;
      # `make platform` calls the same (idempotent) script after every apply,
      # which also restores a deleted Secret.
      - events: ["presync"]
        showlogs: true
        command: ./scripts/ensure-basic-auth.sh
        args:
          - {{ .Values.gateway.namespace | quote }}
          - {{ .Values.basicAuth.secretName | quote }}
          - {{ .Values.basicAuth.username | quote }}
      # Helm does not wait for custom resources; finish only when Envoy is
      # deployed and the Gateway has its address.
      - events: ["postsync"]
        showlogs: true
        command: kubectl
        args:
          - {{ printf "--namespace=%s" .Values.gateway.namespace | quote }}
          - wait
          - --for=condition=Programmed
          - --timeout=300s
          - {{ printf "gateway/%s" .Values.gateway.name | quote }}
