# {{ ansible_managed }}
# Used by `kubeadm join` only and deleted right after it: holds a bootstrap
# token.
apiVersion: kubeadm.k8s.io/v1beta4
kind: JoinConfiguration
discovery:
  bootstrapToken:
    apiServerEndpoint: {{ kubeadm_join_api_server }}
    token: {{ kubeadm_join_token }}
    caCertHashes:
      - {{ kubeadm_join_ca_hash }}
nodeRegistration:
  name: {{ kubeadm_join_node_name }}
  criSocket: {{ kubeadm_join_cri_socket }}
  kubeletExtraArgs:
    - name: node-ip
      value: {{ kubeadm_join_node_ip }}
{% if kubeadm_join_ignore_preflight_errors | length > 0 %}
  ignorePreflightErrors:
{% for item in kubeadm_join_ignore_preflight_errors %}
    - {{ item }}
{% endfor %}
{% endif %}
