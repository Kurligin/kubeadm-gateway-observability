# {{ ansible_managed }}
# Used by `kubeadm init` only; changing it later does not reconfigure a
# running cluster.
apiVersion: kubeadm.k8s.io/v1beta4
kind: InitConfiguration
# The token kubeadm init creates is only for joining nodes; workers get a
# one-time token of their own (`make add-worker`), so this one expires soon
# instead of after the default 24 hours.
bootstrapTokens:
  - description: kubeadm init (expires soon; make add-worker creates its own tokens)
    ttl: 15m0s
    usages:
      - signing
      - authentication
    groups:
      - system:bootstrappers:kubeadm:default-node-token
localAPIEndpoint:
  advertiseAddress: {{ kubeadm_init_node_ip }}
  bindPort: {{ k8s_api_server_port }}
nodeRegistration:
  name: {{ kubeadm_init_node_name }}
  criSocket: {{ kubeadm_init_cri_socket }}
  kubeletExtraArgs:
    - name: node-ip
      value: {{ kubeadm_init_node_ip }}
{% if kubeadm_init_ignore_preflight_errors | length > 0 %}
  ignorePreflightErrors:
{% for item in kubeadm_init_ignore_preflight_errors %}
    - {{ item }}
{% endfor %}
{% endif %}
# Cilium replaces kube-proxy (kubeProxyReplacement=true).
skipPhases:
  - addon/kube-proxy
---
apiVersion: kubeadm.k8s.io/v1beta4
kind: ClusterConfiguration
clusterName: {{ kubeadm_init_cluster_name }}
kubernetesVersion: v{{ k8s_version }}
networking:
  podSubnet: {{ k8s_pod_subnet }}
  serviceSubnet: {{ k8s_service_subnet }}
# controller-manager and scheduler serve metrics (HTTPS, authenticated and
# authorised by the API server) on the node address, so that Prometheus can
# reach them; kubeadm points their liveness probes to the same address.
# etcd keeps the kubeadm default: plain-HTTP metrics on 127.0.0.1:2381 only.
controllerManager:
  extraArgs:
    - name: bind-address
      value: {{ kubeadm_init_node_ip }}
scheduler:
  extraArgs:
    - name: bind-address
      value: {{ kubeadm_init_node_ip }}
---
apiVersion: kubelet.config.k8s.io/v1beta1
kind: KubeletConfiguration
cgroupDriver: systemd
# kubelet_config_settings (group_vars/all/main.yml): serverTLSBootstrap (the
# kubelet asks the cluster CA for its HTTPS serving certificate, approved by
# this role, so that clients such as metrics-server can verify it) and
# parallel image pulls.
{% for key, value in kubelet_config_settings.items() %}
{{ key }}: {{ value | to_json }}
{% endfor %}
