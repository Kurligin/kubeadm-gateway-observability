# {{ ansible_managed }}
# Used by `kubeadm init` only; changing it later does not reconfigure a
# running cluster.
apiVersion: kubeadm.k8s.io/v1beta4
kind: InitConfiguration
localAPIEndpoint:
  advertiseAddress: {{ kubeadm_init_node_ip }}
  bindPort: 6443
nodeRegistration:
  name: {{ kubeadm_init_node_name }}
  criSocket: {{ kubeadm_init_cri_socket }}
  kubeletExtraArgs:
    - name: node-ip
      value: {{ kubeadm_init_node_ip }}
{% if kubeadm_init_ignore_preflight_errors | length > 0 %}
  ignorePreflightErrors:
{% for item in kubeadm_init_ignore_preflight_errors %}
    - {{ item }}
{% endfor %}
{% endif %}
# Cilium replaces kube-proxy (kubeProxyReplacement=true).
skipPhases:
  - addon/kube-proxy
---
apiVersion: kubeadm.k8s.io/v1beta4
kind: ClusterConfiguration
clusterName: {{ kubeadm_init_cluster_name }}
kubernetesVersion: v{{ k8s_version }}
networking:
  podSubnet: {{ k8s_pod_subnet }}
  serviceSubnet: {{ k8s_service_subnet }}
# Metrics endpoints of the control plane listen on all interfaces so that
# Prometheus can scrape them (they still require authentication, except the
# etcd metrics port, which serves metrics only).
controllerManager:
  extraArgs:
    - name: bind-address
      value: 0.0.0.0
scheduler:
  extraArgs:
    - name: bind-address
      value: 0.0.0.0
etcd:
  local:
    extraArgs:
      - name: listen-metrics-urls
        value: http://0.0.0.0:2381
---
apiVersion: kubelet.config.k8s.io/v1beta1
kind: KubeletConfiguration
cgroupDriver: systemd
