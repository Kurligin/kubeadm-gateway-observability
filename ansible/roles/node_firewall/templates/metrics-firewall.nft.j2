#!/usr/sbin/nft -f
# {{ ansible_managed }}
# Metrics and cluster-internal ports of host-network components: reachable
# from this node, from pods and from the other nodes of the cluster only.
# Re-loading the file replaces the table atomically.

table inet {{ node_firewall_table }}
delete table inet {{ node_firewall_table }}

table inet {{ node_firewall_table }} {
    set restricted_ports {
        type inet_service
        elements = { {{ node_firewall_ports | join(', ') }} }
    }

    set allowed_v4 {
        type ipv4_addr
        flags interval
        elements = { {{ (node_firewall_allowed_cidrs + node_firewall_peer_addresses) | unique | join(', ') }} }
    }

    chain input {
        # Before the default filter priority; accepts here do not bypass
        # other tables, so rules of Cilium or the administrator still apply.
        type filter hook input priority filter - 10; policy accept;

        tcp dport != @restricted_ports accept
        fib saddr type local accept
        ip saddr @allowed_v4 accept
        counter reject with tcp reset
    }
}
