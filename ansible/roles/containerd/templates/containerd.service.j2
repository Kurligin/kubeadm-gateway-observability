# {{ ansible_managed }}
# Based on the upstream unit shipped with containerd v{{ containerd_version }}.
# Placed in /etc/systemd/system, so it takes precedence over a unit with the
# same name installed by a distribution package (e.g. containerd.io/Docker).
[Unit]
Description=containerd container runtime
Documentation=https://containerd.io
After=network.target dbus.service

[Service]
ExecStartPre=-/sbin/modprobe overlay
ExecStart=/usr/local/bin/containerd --config /etc/containerd/config.toml

Type=notify
Delegate=yes
KillMode=process
Restart=always
RestartSec=5

LimitNPROC=infinity
LimitCORE=infinity
TasksMax=infinity
OOMScoreAdjust=-999

[Install]
WantedBy=multi-user.target
