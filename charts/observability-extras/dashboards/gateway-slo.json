            "uid": "prometheus"
          },
          "expr": "slo:sli_error:ratio_rate6h{slo=\"app-availability\"} / on (slo) slo:error_budget:ratio{slo=\"app-availability\"}",
          "legendFormat": "6h",
          "refId": "C",
          "range": true
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "slo:sli_error:ratio_rate1d{slo=\"app-availability\"} / on (slo) slo:error_budget:ratio{slo=\"app-availability\"}",
          "legendFormat": "1d",
          "refId": "D",
          "range": true
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "slo:sli_error:ratio_rate3d{slo=\"app-availability\"} / on (slo) slo:error_budget:ratio{slo=\"app-availability\"}",
          "legendFormat": "3d",
          "refId": "E",
          "range": true
        }
