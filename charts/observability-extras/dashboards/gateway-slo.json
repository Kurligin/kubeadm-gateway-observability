    {
      "type": "timeseries",
      "title": "Burn rate (1 = budget spent exactly over the period)",
      "description": "Error ratio divided by the allowed error ratio, per window. Alerts: fast burn when both 1 h and 5 min are above 14.4 (or 6 h and 30 min above 6), slow burn when both 1 d and 2 h are above 3 (or 3 d and 6 h above 1).",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "slo:sli_error:ratio_rate5m{slo=\"app-availability\"} / on (slo) slo:error_budget:ratio{slo=\"app-availability\"}",
          "legendFormat": "5m",
          "refId": "A",
          "range": true
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "slo:sli_error:ratio_rate1h{slo=\"app-availability\"} / on (slo) slo:error_budget:ratio{slo=\"app-availability\"}",
          "legendFormat": "1h",
          "refId": "B",
          "range": true
        },
        {
