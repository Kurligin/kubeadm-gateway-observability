    {
      "type": "stat",
      "title": "Error budget remaining (3-day rate)",
      "description": "1 - burn rate over the last 3 days (the Prometheus retention): the share of the error budget that would be left at the end of the period if errors kept coming at the rate of the last 3 days. Negative: the budget is overspent at that rate.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "1 - (slo:sli_error:ratio_rate3d{slo=\"app-availability\"} / on (slo) slo:error_budget:ratio{slo=\"app-availability\"})",
          "legendFormat": "",
          "refId": "A",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 1,
